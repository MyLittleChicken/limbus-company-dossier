# PostgreSQL 접속 정보
#
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 게임 데이터는 패치마다 전체 재생성하므로 개발용 데이터베이스는 언제든 버려도 된다.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/limbus?schema=public"

# ── MCP 서버(/mcp) ── README 「MCP 서버」 체크리스트 참고. 로컬 개발에서는 모두 비워 둔다.
#
# 사이트 공개 주소. MCP 응답의 siteUrl 링크와 Host·Origin 허용 목록이 쓴다. 없으면 http://127.0.0.1:3100
# SITE_URL="https://example.invalid"
#
# 프로덕션(NODE_ENV=production)에서 1 일 때만 /mcp 를 켠다. 기본 꺼짐(404). 개발에서는 켜짐, 0 이면 끈다.
# MCP_ENABLED="1"
#
# 1 일 때만 클라이언트 IP 를 호출 제한 키로 쓴다(믿을 앞단 프록시가 IP 머리를 덮어쓸 때만). 아니면 키 하나.
# MCP_TRUST_PROXY="1"
#
# x-forwarded-for 의 오른쪽에서 몇 번째 값을 쓸지(믿는 프록시 수). 기본 1.
# MCP_TRUSTED_HOPS="1"
#
# x-forwarded-for 대신 쓸 머리. 예: cf-connecting-ip, x-real-ip
# MCP_CLIENT_IP_HEADER="cf-connecting-ip"
