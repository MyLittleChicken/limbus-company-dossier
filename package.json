{
  "name": "limbus-company-dossier",
  "version": "0.1.0",
  "private": true,
  "description": "림버스 컴퍼니 거울 던전 정보·추천 서비스 — 게임 데이터 파이프라인",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.pipeline.json && tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"lib/**/*.test.ts\" \"src/**/*.test.ts\" \"scripts/rank/*.test.ts\"",
    "fetch": "tsx src/fetch.ts",
    "assets": "tsx src/assets.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:ddl": "docker compose exec -T postgres psql -U postgres -d limbus -v ON_ERROR_STOP=1",
    "v2:schema:validate": "prisma validate --schema prisma/v2/schema.prisma",
    "v2:schema:ddl": "prisma migrate diff --from-empty --to-schema-datamodel prisma/v2/schema.prisma --script > prisma/v2/schema.sql",
    "v2:generate": "prisma generate --schema prisma/v2/schema.prisma",
    "v2:load": "tsx --env-file-if-exists=.env src/v2/load-raw.ts",
    "v2:verify": "tsx --env-file-if-exists=.env src/v2/verify-raw.ts",
    "v2:canonical": "tsx --env-file-if-exists=.env src/v2/load-canonical.ts",
    "v2:seed:authored": "tsx --env-file-if-exists=.env src/v2/seed-authored.ts",
    "v2:verify:canonical": "tsx --env-file-if-exists=.env src/v2/verify-canonical.ts",
    "v2:verify:rebuild": "tsx --env-file-if-exists=.env src/v2/verify-rebuild.ts",
    "v2:build": "tsx --env-file-if-exists=.env src/v2/build-canonical.ts",
    "v2:diff": "tsx --env-file-if-exists=.env src/v2/diff-canonical.ts",
    "v2:promote": "tsx --env-file-if-exists=.env src/v2/promote-canonical.ts promote",
    "v2:rollback": "tsx --env-file-if-exists=.env src/v2/promote-canonical.ts rollback",
    "gift:extract": "tsx --env-file-if-exists=.env scripts/extract-gift-ability.ts",
    "gift:diff": "tsx --env-file-if-exists=.env scripts/diff-gift-ability.ts",
    "gift:split": "tsx --env-file-if-exists=.env scripts/split-clauses.ts",
    "gift:conds": "tsx --env-file-if-exists=.env scripts/extract-conds.ts",
    "gift:merge": "tsx --env-file-if-exists=.env scripts/merge-authored.ts",
    "gift:sim": "tsx --env-file-if-exists=.env scripts/simulate-ability.ts",
    "gift:page": "tsx --env-file-if-exists=.env scripts/build-review-page.ts",
    "gift:import": "tsx --env-file-if-exists=.env scripts/import-verdicts.ts",
    "v2:gap-report": "tsx --env-file-if-exists=.env src/v2/gap-report.ts",
    "v2:reproduce": "tsx --env-file-if-exists=.env src/v2/reproduce.ts",
    "golden:capture": "tsx --env-file-if-exists=.env scripts/golden-queries.ts capture",
    "golden:compare": "tsx --env-file-if-exists=.env scripts/golden-queries.ts compare",
    "public:retire": "tsx scripts/retire-public.ts retire",
    "public:restore": "tsx scripts/retire-public.ts restore",
    "gift:verdict-diff": "tsx --env-file-if-exists=.env scripts/verdict-diff.ts",
    "rank:deck": "tsx --env-file-if-exists=.env scripts/rank-deck.ts",
    "rank:page": "tsx scripts/rank-page.ts",
    "rank:fit": "tsx scripts/fit-weights.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
